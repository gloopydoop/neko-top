# Controlled LUMI-G environment for split/07-pod-mixer-lumi-example.

_prepare_env_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

export NEKO_DIR="${_prepare_env_root}/external/neko"
export ADIOS2_DIR="${_prepare_env_root}/external/adios2"
export ADIOS2_PATH="${ADIOS2_DIR}"
export ADIOS2_FORTRAN_DIR="${ADIOS2_DIR}"

if ! command -v ml >/dev/null 2>&1 || \
   ! command -v ftn >/dev/null 2>&1 || \
   ! command -v cc >/dev/null 2>&1; then
    unset _prepare_env_root
    return 0 2>/dev/null || exit 0
fi

# Clear stale launch/debug overrides that have been poisoning runs.
unset NEKO_BIN
unset NEKO_DEBUG_PROBES
unset NEKO_DEBUG_PROBE_BARRIERS
unset NEKO_STACKTRACE_MODE
unset NEKO_STACKTRACE_DIR
unset NEKO_STACKTRACE_TAG
unset NEKO_STACKTRACE_ONLY_RANK

# Load modules for the Cray CPU environment.
ml CrayEnv cce/20.0.0 cray-mpich/9.0.1 buildtools 2>> /dev/null
export NEKO_CFLAGS="-O3"
export NEKO_FCFLAGS="-O0 -m4"

# HDF5 support.
ml cray-hdf5-parallel/1.14.3.7 2>> /dev/null

# GPU-specific modules.
ml craype-accel-amd-gfx90a rocm/6.3.4 2>> /dev/null
export LD_LIBRARY_PATH="${CRAY_LD_LIBRARY_PATH}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

export HIP_DIR="${ROCM_PATH}"
export HIPCC=hipcc
export AMDGPU_TARGETS=gfx90a
export CMAKE_HIP_ARCHITECTURES=gfx90a
export NEKO_HIPCC_FLAGS="-O3 --offload-arch=gfx90a"
export NEKO_CONFIG_FLAGS=(--enable-device-mpi)
export MPICH_GPU_SUPPORT_ENABLED=1
export MPICH_DMAPP_APP_IS_WORLD=1
export NEKO_GS_STRTGY=3

# Set CMake build type and compilers.
export CMAKE_BUILD_TYPE=Release
export MPIFC=ftn
export MPICC=cc
export MPICXX=CC
export FC=ftn
export CC=cc

# KTH
export LUMI_ACCOUNT=project_465002526

# CEEC
# export LUMI_ACCOUNT=project_465002946

source /scratch/project_465002526/nobishar/python_pySEMTools/bin/activate

export NEKO_LAUNCHER=srun

unset _prepare_env_root
