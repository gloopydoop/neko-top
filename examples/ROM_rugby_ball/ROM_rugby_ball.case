{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": false,
        "time": {
            "end_time": 1.0,
            "timestep": 2.5e-3
        },
        "numerics": {
            "time_order": 1,
            "polynomial_order": 5,
            "dealias": false
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 200.0,
            "initial_condition": {
                "type": "uniform",
                "value": [ 1.0, 0.1, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-4,
                "max_iterations": 80
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-4,
                "max_iterations": 80
            },
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ],
            "output_control": "never",
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ],
            "output_control": "never",
            "norm_output_control": "tsteps",
            "norm_output_value": 100.0,
            "norm_output_file": "adjoint_norm.csv"
        },
        "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [ 0.2, 0.8 ],
                "y_bounds": [ 0.2, 0.8 ],
                "z_bounds": [ -1.0, 1.0 ]
            },
            {
                "name": "objective_domain",
                "geometry": "box",
                "x_bounds": [
                    1.0,
                    2.5,
                ],
                "y_bounds": [
                    -0.1,
                    1.1,
                ],
                "z_bounds": [
                    -1.0,
                    1.0,
                ],
            },
            {
                "name": "initial_ball",
                "geometry": "cylinder",
                "start": [ 0.5, 0.5, -0.5 ],
                "end": [ 0.5, 0.5, 1.5 ],
                "radius": 0.15
            },
        ]
    },
    "unsteady" : true,
    "state_recovery": {
        "type": "rom",
        "batch_size": 30,
        "n_modes": 4,
        "stream_adjoint": true,
        "adjoint_i_stream": 50,
        "history_outer_iterations": 3,
        "rank_forward": 4,
        "rank_adjoint": 4,
        "rank_total_max": 8,
        "scalar_metric_weight": 1.0,
        "i_stream": 50,
        "dtype": "double",
        "output_reconstruction": false,
        "write_modes": false,
        "adjoint_output_file_name": "adjoint_POD_modes",
    },
    "rom": {
        "enabled": true,
        "inner_iterations": 10,
        "history_outer_iterations": 3,
        "rank_forward": 4,
        "rank_adjoint": 4,
        "rank_total_max": 8,
        "scalar_metric_weight": 1.0,
        "validate_full_order": false,
        "admissibility_projection": "velocity_inlet_xmin",
        "time_scheme": "bdf1",
        "pressure_treatment": "solenoidal_galerkin",
        "projection_outer_iterations": 1,
        "projection_pressure_absolute_tolerance": 1.0e-10,
        "projection_pressure_relative_tolerance": 0.0,
        "projection_pressure_max_iterations": 80,
        "projection_diagnostics_file": "rom_projection_diagnostics.csv",
        "strict_admissibility": false,
        "write_trajectory_fields": false,
        "trajectory_output_interval": 0.5,
        "lift": {
            "source": "initial_velocity"
        }
    },
    "optimization": {
        "design": {
            "type": "brinkman",
            "mapping": [
                {
                    "type": "PDE_filter",
                    "r": 0.05
                },
                {
                    "type": "RAMP",
                    "f_max": 100.0,
                    "q": 3.0
                }
            ],
            "initial_distribution": {
                "type": "point_zone",
                "base_value": 0.0,
                "zone_value": 1.0,
                "zone_name": "initial_ball"
            },
            "domain": {
                "type": "point_zone",
                "zone_name": "optimization_domain"
            }
        },
        "solver": {
            "type": "rom_mma",
            "max_iterations": 10,
            "tolerance": 1.0e-12,
            "mma": {
                "scale": 1.0,
                "move_limit": 0.10,
                "asyinit": 0.8,
                "asyincr": 1.05,
                "asydecr": 0.65,
                "xmin": 0.0,
                "xmax": 1.0,
            }
        },
        "objectives": [
            {
                "type": "viscous_dissipation",
                "mask_name": "objective_domain",
                "weight": 8.0
            },
            {
                "type": "brinkman_dissipation",
                "mask_name": "optimization_domain",
                "weight": 8.0,
                "dealias_sensitivity": false,
                "dealias_forcing": false
            }
        ],
        "constraints": [
            {
                "type": "volume",
                "mask_name": "optimization_domain",
                "limit": 0.1,
                "is_max": false
            }
        ]
    }
}
